# NVIDIA NIM (OpenAI-compatible endpoint)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Models (served by NIM). Cheap/fast one for the persona panel, stronger one for analysis.
# Only these two are on the NIM free tier right now; lightning is the fast one.
RAC_PANEL_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
RAC_ANALYSIS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
RAC_MAX_OUTPUT_TOKENS=1500

# Throughput guardrails (NIM free tier is ~40 requests/minute, no daily cap)
RAC_REQUESTS_PER_MINUTE=36
RAC_MAX_CONCURRENCY=4

# Panel sizing. The free nemotron models are slow (~60s/call) so keep these
# small while developing in LangGraph Studio; raise for a real study.
RAC_PERSONAS_PER_SEGMENT=4
RAC_BATCH_SIZE=4

# LangSmith tracing: set KEY (from smith.langchain.com) then flip TRACING to true.
# LangGraph Studio (`langgraph dev`) shows traces locally even with this off.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rentacrowd

